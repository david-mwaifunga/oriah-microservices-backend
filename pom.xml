<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.oriah</groupId>
    <artifactId>oriah-api-parent</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>oriah-api-parent</name>
    <description>
        Oriah Jewelry — backend microservices parent.
        Multi-module Maven project: domain services under services/, platform under infra/,
        cross-cutting libraries under shared/. Each module is a Spring Boot 4 application
        or library. Version management for Spring Boot, Spring Cloud, Testcontainers,
        and SpringDoc OpenAPI is centralized here so every service stays aligned.
    </description>

    <modules>
        <module>shared</module>
        <module>infra</module>
        <module>services</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.source>${java.version}</maven.compiler.source>
        <maven.compiler.target>${java.version}</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <!-- Platform versions: change in one place. -->
        <spring-boot.version>4.0.6</spring-boot.version>
        <!-- Spring Cloud release train for Spring Boot 4 — verify exact GA when we add config server. -->
        <!--
            Spring Cloud release train. The 2025.0.x line targets Spring Boot
            3.5; the 2025.1.x line is the parallel branch built against Spring
            Boot 4 / Spring Framework 7. Spring Initializr confirms 2025.1.1
            works with SB 4.0.6 (David verified by generating a starter).
        -->
        <spring-cloud.version>2025.1.1</spring-cloud.version>
        <springdoc.version>3.0.2</springdoc.version>
        <!--
            Object storage and image handling, none of which the Spring Boot
            BOM manages.

            TwelveMonkeys replaces hand-rolling the two things stock ImageIO
            gets wrong for photographs: CMYK/YCCK JPEGs, which it decodes as
            channel-garbled nonsense, and WebP, which it cannot read at all.
            metadata-extractor reads EXIF orientation, which ImageIO exposes
            only as a raw APP1 segment to be parsed by hand.
        -->
        <aws-sdk.version>2.55.14</aws-sdk.version>
        <twelvemonkeys.version>3.15.3</twelvemonkeys.version>
        <metadata-extractor.version>2.21.0</metadata-extractor.version>

        <!-- Maven plugin versions (pin so the build is reproducible regardless of what Maven defaults to). -->
        <maven-compiler-plugin.version>3.15.0</maven-compiler-plugin.version>
        <maven-enforcer-plugin.version>3.6.3</maven-enforcer-plugin.version>
        <!--
            Testcontainers version is managed by Spring Boot 4's BOM (its 2.x line,
            which renamed artifacts to testcontainers-* and packages to org.testcontainers.<module>).
            No standalone testcontainers BOM import needed.
        -->
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Spring Boot BOM: every spring-boot-* and managed transitive (Testcontainers, Hibernate, etc.) gets its version from here. -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- SpringDoc OpenAPI — pinned (not part of Spring Boot BOM). -->
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>

            <!--
                Spring Cloud BOM. Version 2025.1.1 is the Spring-Boot-4 line
                (2025.0.x is the SB 3.5 line — do NOT use that branch with our
                stack). Manages versions for spring-cloud-config-server,
                spring-cloud-starter-config, spring-cloud-starter-netflix-eureka-*,
                spring-cloud-starter-gateway, spring-cloud-starter-openfeign,
                spring-cloud-starter-circuitbreaker-resilience4j.
            -->
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!--
                AWS SDK v2 BOM. Pinned here like springdoc, because the Spring
                Boot BOM does not manage it.

                The S3 API is how catalog talks to object storage, and the
                client is deliberately vendor-neutral rather than MinIO's own:
                this phase was planned against MinIO and MinIO's server and
                client images turned out to have been withdrawn from Docker
                Hub (the minio/ namespace still publishes twenty repositories;
                minio/minio and minio/mc are not among them, and an
                authenticated pull fails exactly as an anonymous one does).
                Changing to SeaweedFS cost an endpoint property. Had we used a
                vendor SDK it would have cost a rewrite.
            -->
            <dependency>
                <groupId>software.amazon.awssdk</groupId>
                <artifactId>bom</artifactId>
                <version>${aws-sdk.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.version}</version>
                    <configuration>
                        <excludes>
                            <exclude>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                            </exclude>
                        </excludes>
                        <!--
                            How every service image is built (spring-boot:build-image).

                            BP_JVM_VERSION=25: the JRE inside the image is 25, the
                            same as the JDK the build is held to (maven-enforcer
                            below). Left unset, the Java buildpack picks its own
                            default, which moves when the buildpack is updated and
                            is not the JDK the code was tested on. The language
                            level stays 21 (java.version), which 25 runs.

                            Builder and run image are pinned by DIGEST, not by the
                            moving :latest tag. A digest names exact bytes, so two
                            builds a month apart produce the same base, and a base
                            update (a new JRE patch, a changed memory calculator)
                            reaches the stack as a visible commit that changes these
                            two lines, never silently on somebody's next rebuild.
                            To update: docker pull the new tag, read its digest from
                            the RepoDigests field of docker image inspect, change both
                            lines, rebuild all 16 images, run the smoke test.

                            run-noble-base (not the smaller default run image)
                            because the compose healthchecks need bash. See
                            build-images.ps1.

                            pullPolicy IF_NOT_PRESENT: bytes named by a digest never
                            change, so there is nothing to re-check on every build,
                            and a build no longer depends on the registry being
                            reachable (the "unexpected EOF" pull failures that
                            build-images.ps1 retries around).

                            Merged, not replaced, by a module's own image block:
                            the gateway adds its JAVA_TOOL_OPTIONS beside this.
                        -->
                        <image>
                            <builder>paketobuildpacks/builder-noble-java-tiny@sha256:8da9782949bb9f39f4b9d8079216531fe2791286fe33bbf450e533949cfbcc91</builder>
                            <runImage>paketobuildpacks/run-noble-base@sha256:d16d0d825f312fc0d5534466c5f8ae5277c97cc73fc97a9998bd29af89f27284</runImage>
                            <pullPolicy>IF_NOT_PRESENT</pullPolicy>
                            <env>
                                <BP_JVM_VERSION>25</BP_JVM_VERSION>
                            </env>
                        </image>
                    </configuration>
                    <executions>
                        <execution>
                            <!--
                                Generates META-INF/build-info.properties, which
                                Actuator's BuildInfoContributor surfaces as the
                                build.* block of /actuator/info:
                                build.artifact, build.name, build.group,
                                build.version and build.time.

                                Without this the whole build block is absent and
                                /actuator/info on a running container cannot tell
                                you which build produced it. With 15 images all
                                tagged :dev, that is the difference between
                                debugging a known artifact and guessing. Asserted
                                by smoke-test.ps1 step 16.

                                Not inherited from spring-boot-starter-parent
                                because this project imports BOMs instead of
                                parenting from it, so the execution is declared
                                here and picked up by every module that uses the
                                plugin.
                            -->
                            <id>build-info</id>
                            <goals>
                                <goal>build-info</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven-compiler-plugin.version}</version>
                    <configuration>
                        <release>${java.version}</release>
                        <!--
                            Preserve method parameter names in bytecode. Spring needs
                            these to bind @PathVariable / @RequestParam / @RequestHeader
                            without forcing every parameter to spell its name explicitly
                            (@PathVariable("id") UUID id). spring-boot-starter-parent sets
                            this by default; we don't inherit from it (we inherit BOMs
                            instead), so we set it ourselves.
                        -->
                        <parameters>true</parameters>
                        <!-- Lombok version is managed by Spring Boot BOM. -->
                        <annotationProcessorPaths>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                            </path>
                        </annotationProcessorPaths>
                    </configuration>
                </plugin>
                <!--
                    Surefire with Mockito attached as an explicit Java agent.
                    Without this, Mockito self-attaches at first use and the JDK
                    prints "Mockito is currently self-attaching to enable the
                    inline-mock-maker. This will no longer work in future
                    releases of the JDK." A future JDK will turn that warning
                    into a hard failure; declaring the agent now future-proofs us.

                    The path to the mockito-core jar is exposed as a Maven
                    property by maven-dependency-plugin:properties (configured
                    below). The property name is the GAV of the artifact:
                    `org.mockito:mockito-core:jar` (no version — Maven resolves
                    via the BOM-managed version).
                -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <configuration>
                        <argLine>-javaagent:${org.mockito:mockito-core:jar} -Xshare:off</argLine>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
        <!--
            maven-dependency-plugin:properties resolves every dependency's
            jar path and stamps it into a Maven property named after the
            artifact's GA(:T). Bound to 'initialize' (the default phase for
            this goal) so the property exists by the time surefire's argLine
            is evaluated.
        -->
        <plugins>
            <!--
                Refuse to build on any JDK but 25.

                The language level stays 21 (java.version / release above): the
                code is written to run on 21 and a second target is cheap to keep.
                But the JDK that BUILDS and the JRE that RUNS must be one version,
                not whatever each machine happens to have, or a service passes its
                tests on one JDK and runs on another. The images run JDK 25
                (BP_JVM_VERSION, in the plugin configuration above), so the build
                is held to 25 too. [25,26) is "25.x and nothing else": a newer
                JDK is a decision to make, not an accident to discover.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>${maven-enforcer-plugin.version}</version>
                <executions>
                    <execution>
                        <id>enforce-build-jdk</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion>
                                    <version>[25,26)</version>
                                    <message>This project builds on JDK 25 (language level 21, build and runtime JDK 25). Point JAVA_HOME at a JDK 25.</message>
                                </requireJavaVersion>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <id>resolve-test-dependency-paths</id>
                        <goals>
                            <goal>properties</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
