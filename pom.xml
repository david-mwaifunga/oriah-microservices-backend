<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.oriah</groupId>
    <artifactId>oriah-api-parent</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>oriah-api-parent</name>
    <description>
        Oriah Jewelry — backend microservices parent.
        Multi-module Maven project: domain services under services/, platform under infra/,
        cross-cutting libraries under shared/. Each module is a Spring Boot 4 application
        or library. Version management for Spring Boot, Spring Cloud, Testcontainers,
        and SpringDoc OpenAPI is centralized here so every service stays aligned.
    </description>

    <modules>
        <module>services</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.source>${java.version}</maven.compiler.source>
        <maven.compiler.target>${java.version}</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <!-- Platform versions: change in one place. -->
        <spring-boot.version>4.0.6</spring-boot.version>
        <!-- Spring Cloud release train for Spring Boot 4 — verify exact GA when we add config server. -->
        <!--
            Spring Cloud version is intentionally NOT pinned to a real number.
            As of this commit there is no Spring Cloud release train that targets
            Spring Boot 4: the latest stable is 2025.0.0 (Spring Boot 3.5),
            which crashes on SB 4 with NoClassDefFoundError for
            WebServerInitializedEvent (moved/removed in Spring Framework 7).
            See docs/ARCHITECTURE.md "Spring Cloud blocker" section.
            Iterations 3-5 (Config Server, Eureka, Gateway) are deferred until
            a 2026.x train ships.
        -->
        <spring-cloud.version>UNSET-pending-2026-train</spring-cloud.version>
        <springdoc.version>3.0.2</springdoc.version>
        <!-- Maven plugin versions (pin so the build is reproducible regardless of what Maven defaults to). -->
        <maven-compiler-plugin.version>3.15.0</maven-compiler-plugin.version>
        <!--
            Testcontainers version is managed by Spring Boot 4's BOM (its 2.x line,
            which renamed artifacts to testcontainers-* and packages to org.testcontainers.<module>).
            No standalone testcontainers BOM import needed.
        -->
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Spring Boot BOM: every spring-boot-* and managed transitive (Testcontainers, Hibernate, etc.) gets its version from here. -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- SpringDoc OpenAPI — pinned (not part of Spring Boot BOM). -->
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>

            <!--
                Spring Cloud BOM — to be uncommented when a Spring-Boot-4-compatible
                Spring Cloud release ships. Confirmed broken with 2025.0.0:
                NoClassDefFoundError on WebServerInitializedEvent (Framework-7
                removal). See docs/ARCHITECTURE.md.

            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            -->

        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.version}</version>
                    <configuration>
                        <excludes>
                            <exclude>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                            </exclude>
                        </excludes>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven-compiler-plugin.version}</version>
                    <configuration>
                        <release>${java.version}</release>
                        <!--
                            Preserve method parameter names in bytecode. Spring needs
                            these to bind @PathVariable / @RequestParam / @RequestHeader
                            without forcing every parameter to spell its name explicitly
                            (@PathVariable("id") UUID id). spring-boot-starter-parent sets
                            this by default; we don't inherit from it (we inherit BOMs
                            instead), so we set it ourselves.
                        -->
                        <parameters>true</parameters>
                        <!-- Lombok version is managed by Spring Boot BOM. -->
                        <annotationProcessorPaths>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                            </path>
                        </annotationProcessorPaths>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
