<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.oriah</groupId>
        <artifactId>infra</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>gatewayserver</artifactId>
    <packaging>jar</packaging>

    <name>gatewayserver</name>
    <description>Spring Cloud Gateway — single entry point routing to backend services via Eureka.</description>

    <dependencies>
        <!--
            Spring Cloud Gateway, reactive (Netty/WebFlux) flavor.
            NB: in Spring Cloud 2025.1.x the artifact got renamed from the
            shorter spring-cloud-starter-gateway to this fully-qualified form
            because there's now also a servlet variant
            (spring-cloud-starter-gateway-server-webmvc). The webflux variant
            is what most "Spring Cloud Gateway" docs and books still describe.
            It pulls in spring-boot-starter-webflux as a transitive — this
            module is the only WebFlux/Netty piece of our system; the rest
            stays on MVC.
        -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-gateway-server-webflux</artifactId>
        </dependency>

        <!--
            Eureka client. The gateway uses Eureka to resolve 'lb://catalog'
            (and future service names) into concrete host:port pairs at
            request time. Without this, the lb:// scheme has no resolver.
        -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-netflix-eureka-client</artifactId>
        </dependency>

        <!--
            Actuator: exposes /actuator/gateway/routes (the configured route
            table) and /actuator/health for orchestration probes.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!--
            Cross-cutting observability: tracing + metrics + JSON logs.
            See shared/oriah-observability-starter. The Gateway, being a
            WebFlux app, benefits from server-span tracing the most —
            it's the entrypoint where the traceId is born.
        -->
        <dependency>
            <groupId>com.oriah</groupId>
            <artifactId>oriah-observability-starter</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!--
            Reactive Redis client (Lettuce). Backing store for
            Spring Cloud Gateway's RedisRateLimiter. The rate-limiter
            uses a Lua script atomically against Redis so the limit
            is shared across multiple gateway instances. Single-
            instance dev does not strictly need this (an in-memory
            limiter would do) but matches the prod shape from day one.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis-reactive</artifactId>
        </dependency>

        <!--
            Reactive Springdoc + Swagger UI. Aggregates every service's
            /v3/api-docs into a single dropdown at
            http://localhost:8080/swagger-ui.html. The 12 service
            specs themselves are reached via Path-prefix routes
            declared in application.yaml that rewrite
            /v3/api-docs/{svc} -> /v3/api-docs on the upstream.
            Reactive (webflux) variant because the gateway is Netty,
            not Tomcat.
        -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webflux-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>

        <!-- Lombok: @Slf4j on the application class for the startup banner. -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!--
            Test classpath. Reactive (WebFlux) stack, so we want the
            webflux-test starter — NOT webmvc-test. webflux-test brings in
            WebTestClient if we ever want fluent reactive assertions; for
            the smoke tests we stick with java.net.http.HttpClient like the
            Eureka tests do, for portability across SB minor versions.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webflux-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <!--
                        Bake an extra JVM flag into the Buildpack-generated image
                        so it carries the gateway's required direct-memory ceiling
                        regardless of where it is deployed (compose, k8s, plain
                        docker run).

                        Why this knob, here, on this module only:
                        - Paketo's memory calculator hardcodes
                          MaxDirectMemorySize=10M, regardless of container
                          memory size, BPL_JVM_HEAD_ROOM, or BPL_JVM_THREAD_COUNT
                          (verified by booting the image standalone with
                          `docker run` and reading the calculator's output
                          line). 10M is fine for a typical Spring MVC service, but
                          for the gateway's reactive Netty + Lettuce + Reactor
                          pipeline it gets exhausted within seconds of a steady
                          load -> "Cannot reserve N bytes of direct buffer
                          memory" -> ProblemDetailExceptionHandler fires after
                          ServerHttpResponse has already committed -> crashes
                          itself on ReadOnlyHttpHeaders.set -> client sees
                          200 OK + 0 body + dropped connection. The MVC services
                          do not allocate direct buffers in the request path,
                          so they do not need this and stay on the default.

                        BPE_APPEND_JAVA_TOOL_OPTIONS + BPE_DELIM_JAVA_TOOL_OPTIONS
                        is the Cloud Native Buildpack standard for adding to an
                        existing env variable rather than overriding it. The
                        calculator's other args (Xmx, MaxMetaspaceSize, etc.)
                        still come through unchanged, and the calculator notices
                        MaxDirectMemorySize is already set and skips its own
                        default. xml:space="preserve" keeps the delimiter as a
                        literal space (XML would normalize otherwise).

                        128m is generous for dev; a future tune (heavier load
                        testing + NMT readout) might pull this down or up.
                    -->
                    <image>
                        <env>
                            <BPE_APPEND_JAVA_TOOL_OPTIONS xml:space="preserve">-XX:MaxDirectMemorySize=128m</BPE_APPEND_JAVA_TOOL_OPTIONS>
                            <BPE_DELIM_JAVA_TOOL_OPTIONS xml:space="preserve"> </BPE_DELIM_JAVA_TOOL_OPTIONS>
                        </env>
                    </image>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
