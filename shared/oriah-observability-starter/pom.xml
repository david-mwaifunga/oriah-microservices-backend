<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.oriah</groupId>
        <artifactId>shared</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>oriah-observability-starter</artifactId>
    <packaging>jar</packaging>

    <name>oriah-observability-starter</name>
    <description>
        Cross-cutting observability stack: distributed tracing (Micrometer Tracing
        bridged to OpenTelemetry, exported to Zipkin), JSON-format Logback config
        with traceId/spanId MDC fields for correlation, and metrics exposure via
        the Actuator + Prometheus registry. Every Spring service and infra module
        depends on this jar — one version-bump in the parent BOM updates the
        observability stack across all 15 modules.
    </description>

    <dependencies>
        <!--
            Spring Boot Actuator gives us /actuator/health, /actuator/info, and
            (via micrometer-registry-prometheus below) /actuator/prometheus —
            the scrape endpoint Prometheus reads. Declared 'compile' so any
            module that depends on this starter gets actuator for free.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!--
            Spring Boot 4 split tracing autoconfig out of the actuator-
            autoconfigure jar into per-tracer modules. This one carries the
            @AutoConfiguration classes that bind the Tracer bean, the
            ObservationHandler chain, the propagation factories and the OTLP
            exporter wiring to Spring Boot properties (sampling, endpoint,
            timeouts). Without it the instrumentation never activates: there is
            no MDC traceId and no span export, regardless of what
            management.tracing.* says.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-micrometer-tracing-opentelemetry</artifactId>
        </dependency>

        <!--
            OTLP trace export, for Grafana Tempo. This is what supplies
            opentelemetry-exporter-otlp and therefore the OtlpHttpSpanExporter
            bean; spring-boot-micrometer-tracing-opentelemetry above carries the
            auto-configuration but NOT the exporter itself. Without this
            dependency there is no SpanExporter bean at all, and spans are
            produced and silently discarded.

            That is not hypothetical: removing spring-boot-zipkin in the Tempo
            cutover accidentally took this dependency with it, and
            SpanExporterCoexistenceTest caught it immediately with
            "SpanExporter beans: []", before any image was built because the
            build is gated on the tests passing. Hence the assertion in that
            test that the exporter set is non-empty, which is the one thing
            that must hold no matter which backend is in use.

            It replaced spring-boot-zipkin. The swap was staged, not cut over:
            OTLP was added alongside Zipkin, the coexistence test confirmed both
            exporters were wired simultaneously, and smoke-test.ps1 proved the
            same traceId reached Tempo across all seven saga services before
            Zipkin was removed.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-opentelemetry</artifactId>
        </dependency>

        <!--
            Micrometer Tracing facade + OTel bridge. Spring Boot's auto-
            config wires a Tracer bean when this is on the classpath and
            turns on HTTP-server, RestClient, Feign, WebFlux, Spring
            Cloud Stream, and JDBC instrumentation. The 'bridge-otel'
            artifact means we speak Micrometer Tracing's API on the call
            sites and OpenTelemetry's wire format on the way out.
        -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-tracing-bridge-otel</artifactId>
        </dependency>

        <!--
            feign-micrometer wires OpenFeign clients into the Micrometer
            Observation pipeline. Without it, Feign's HTTP calls open new
            traces instead of propagating the caller's traceparent header
            downstream; the checkout saga shows up in Zipkin as four
            disconnected single-service traces instead of one
            cross-service tree. With it, calls from checkout to cart /
            promotion / shipping / payment / order all carry the same
            traceId. Catalog -> inventory (also Feign) benefits too.
        -->
        <dependency>
            <groupId>io.github.openfeign</groupId>
            <artifactId>feign-micrometer</artifactId>
        </dependency>

        <!--
            Prometheus registry. Adds /actuator/prometheus to every service
            so Prometheus can scrape http.server.requests, jvm.memory.used,
            etc. without per-service wiring.
        -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>

        <!--
            Logstash Logback encoder. Renders each log event as a one-line
            JSON object, including any MDC values (traceId, spanId). Pinned
            because Spring Boot's BOM doesn't manage this artifact.
            8.0 is the current GA on Logback 1.5.x (which SB 4.0.6 brings).
        -->
        <dependency>
            <groupId>net.logstash.logback</groupId>
            <artifactId>logstash-logback-encoder</artifactId>
            <version>8.0</version>
        </dependency>

        <!--
            Spring Web for @RestControllerAdvice + ProblemDetail.
            jakarta.persistence-api for the EntityNotFoundException
            handler. Both are 'compile' rather than 'provided' because
            Spring's bean post-processor reflectively introspects the
            handler class at startup. If EntityNotFoundException is not
            on the runtime classpath, the introspection throws
            NoClassDefFoundError and the whole context fails to start
            (this broke configserver / eurekaserver / gatewayserver /
            shipping / checkout the first time around). compile scope guarantees the API classes are
            transitively present everywhere the starter is.
        -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
        </dependency>
        <dependency>
            <groupId>jakarta.persistence</groupId>
            <artifactId>jakarta.persistence-api</artifactId>
        </dependency>

        <!--
            jakarta.servlet-api is needed to COMPILE the framework-exception
            handlers in ProblemDetailExceptionHandler: spring-web's
            HttpRequestMethodNotSupportedException,
            HttpMediaTypeNotSupportedException,
            MissingServletRequestParameterException and
            ServletRequestBindingException all extend
            jakarta.servlet.ServletException.

            Why 'compile' and not 'provided': Spring introspects every
            @ExceptionHandler method signature at context startup, so the
            exception types must be loadable at runtime in EVERY module that
            picks up this advice, including gatewayserver, which is reactive
            and has no servlet stack of its own. 'provided' would reproduce the
            NoClassDefFoundError that broke five modules when spring-web was
            scoped that way.

            Why this does NOT flip gatewayserver to a servlet app:
            WebApplicationType.deduceFromClasspath() returns REACTIVE when
            DispatcherHandler is present and
            org.springframework.web.servlet.DispatcherServlet is absent. We add
            only the servlet API, never spring-webmvc, so DispatcherServlet
            stays absent. That reasoning is pinned by
            GatewayServerWebApplicationTypeTest, which fails loudly if anything
            ever drags spring-webmvc onto the gateway.
        -->
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
        </dependency>

        <!--
            spring-security-core for AccessDeniedException in the
            problem-details advice. Every service that hits @PreAuthorize
            already has spring-security on its path via the OAuth2
            resource-server starter; this declared dep is for the
            advice class's compile-time symbol.
        -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-core</artifactId>
        </dependency>

        <!-- Lombok for @Slf4j on the exception handler. Provided so we
             do not re-export it onto consumers (they already have it). -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>

        <!--
            Test deps. starter-test brings JUnit + MockMvc + AssertJ;
            starter-webmvc-test gives us the servlet test context;
            starter-validation provides Hibernate Validator so
            @Valid + @NotBlank actually trigger
            MethodArgumentNotValidException during the test that
            exercises the validation-failure branch of the advice.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
