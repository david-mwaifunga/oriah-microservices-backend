<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.oriah</groupId>
        <artifactId>services</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>catalog</artifactId>
    <packaging>jar</packaging>

    <name>catalog</name>
    <description>Oriah catalog microservice — products, variants, collections.</description>

    <dependencies>
        <!-- Web -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!--
            Cross-cutting observability: tracing + metrics + JSON logs.
            See shared/oriah-observability-starter.
        -->
        <dependency>
            <groupId>com.oriah</groupId>
            <artifactId>oriah-observability-starter</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- The ngwee rule for money (shared/oriah-money), and its edge guard for tests. -->
        <dependency>
            <groupId>com.oriah</groupId>
            <artifactId>oriah-money</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.oriah</groupId>
            <artifactId>oriah-money</artifactId>
            <version>${project.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <!--
            The event log (shared/oriah-events, MVP_PLAN Phase 1): every
            product and price change is appended to catalog's own outbox in
            the transaction that makes it, and the relay publishes it to
            catalog.product. Its test-jar carries the schema guards that prove
            V4 copied the reference tables exactly.
        -->
        <dependency>
            <groupId>com.oriah</groupId>
            <artifactId>oriah-events</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.oriah</groupId>
            <artifactId>oriah-events</artifactId>
            <version>${project.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>

        <!--
            Shared JPA base: AuditableEntity (@MappedSuperclass with
            audit columns + @SoftDelete) + KeycloakAuditorAware.
            Activated by config/JpaConfig. Only entity-bearing
            services declare this; non-JPA services (configserver,
            eurekaserver, gatewayserver, shipping, checkout) do not,
            keeping their classpaths free of spring-data-*.
        -->
        <dependency>
            <groupId>com.oriah</groupId>
            <artifactId>oriah-jpa-base</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!--
            Object storage, over the S3 API.

            url-connection-client, not the default apache-client and
            emphatically not netty-nio-client: this is a blocking MVC service,
            so an async HTTP stack buys nothing, and the gateway's experience
            with Netty direct buffers (its image bakes
            -XX:MaxDirectMemorySize=128m because Paketo's 10M default exhausted
            them under steady load) is a good reason not to add a second Netty
            to a service that currently has none.
        -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>s3</artifactId>
            <exclusions>
                <!-- Pulled in transitively; replaced by url-connection-client below. -->
                <exclusion>
                    <groupId>software.amazon.awssdk</groupId>
                    <artifactId>netty-nio-client</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>software.amazon.awssdk</groupId>
                    <artifactId>apache-client</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>url-connection-client</artifactId>
        </dependency>

        <!--
            Image decoding beyond what the JDK ships.

            imageio-jpeg: stock ImageIO cannot decode CMYK or YCCK JPEGs,
            which is the colour space print-oriented product photography
            arrives in. It does not fail cleanly either: it produces an
            image with the channels misread, so the defect ships as a product
            photo with inverted colours rather than as an error.

            imageio-webp: adds WebP reading, so an admin can upload what their
            tooling exports.

            Both register through ImageIO's ServiceLoader, so no code
            references them; they are on the classpath and ImageIO finds them.
        -->
        <dependency>
            <groupId>com.twelvemonkeys.imageio</groupId>
            <artifactId>imageio-jpeg</artifactId>
            <version>${twelvemonkeys.version}</version>
        </dependency>
        <dependency>
            <groupId>com.twelvemonkeys.imageio</groupId>
            <artifactId>imageio-webp</artifactId>
            <version>${twelvemonkeys.version}</version>
        </dependency>

        <!--
            EXIF orientation. Needed because stripping orientation without
            APPLYING it leaves a camera's sideways pixels with nothing left to
            say they are sideways, so a supplier's photo silently appears
            rotated on the storefront.
        -->
        <dependency>
            <groupId>com.drewnoakes</groupId>
            <artifactId>metadata-extractor</artifactId>
            <version>${metadata-extractor.version}</version>
        </dependency>

        <!-- Persistence -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- API docs -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        </dependency>

        <!--
            Spring Cloud Config Client. Catalog pulls service-specific config
            (springdoc paths, logging levels, future settings) from the Config
            Server at startup. See the spring.config.import line in
            application.yaml — the 'optional:' prefix means catalog still boots
            when the Config Server is unreachable (tests, offline dev).
        -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-config</artifactId>
        </dependency>

        <!--
            Spring Cloud Bus over Kafka. POST /actuator/busrefresh on
            the configserver (or any bus client) publishes a
            RefreshRemoteApplicationEvent on the springCloudBus topic;
            every listening client re-binds its
            @ConfigurationProperties from the new config-repo values
            in place. No service restart, no per-client curl loop.
        -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-bus-kafka</artifactId>
        </dependency>

        <!--
            Spring Cloud Eureka Client. Auto-registers catalog with the Eureka
            server on startup using spring.application.name (= "catalog") so
            other services (gateway, future inventory) can look it up by name
            instead of host:port. Disabled in tests via @TestPropertySource so
            tests don't depend on Eureka being up.
        -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-netflix-eureka-client</artifactId>
        </dependency>

        <!--
            OpenFeign: declarative HTTP client. Catalog uses an @FeignClient
            interface to call the inventory service via Eureka lookup
            (@FeignClient(name = "inventory")). The Feign auto-config wires
            in Spring Cloud LoadBalancer behind the scenes so we get
            client-side load balancing across however many inventory
            instances are registered.
        -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-openfeign</artifactId>
        </dependency>

        <!--
            Resilience4j circuit breaker. Wraps every Feign call: if
            inventory is unreachable or slow, the circuit opens and
            subsequent calls short-circuit to the fallback returning
            "availability unknown" — catalog stays up even when inventory
            is down. Enabled via feign.circuitbreaker.enabled: true in
            application.yaml.
        -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-circuitbreaker-resilience4j</artifactId>
        </dependency>

        <!--
            Spring Security + OAuth2 Resource Server.
            Catalog validates incoming JWTs against Keycloak's JWKS
            endpoint (configured via spring.security.oauth2.resourceserver.
            jwt.issuer-uri). Admin endpoints require the CATALOG_ADMIN
            role; public reads stay permitAll.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>

        <!--
            Spring Cloud Stream + Kafka binder. Catalog's outbox relay
            (oriah-events) publishes product.created / product.updated /
            product.deleted on 'catalog.product' through it, sending each
            outbox row to the topic named on the row, and answers replay
            requests on oriah.outbox.replay-requests.
        -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-stream-kafka</artifactId>
        </dependency>

        <!-- Boilerplate reduction -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Dev convenience: hot reload during development. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>

        <!--
            Test classpath: Spring Boot 4 splits the old spring-boot-starter-test
            into per-feature test starters so the test classpath only has what
            the slice under test needs.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
            No testcontainers-minio dependency, deliberately. The module exists
            on Central at the version this build uses, but it pulls a MinIO
            image, which is the thing that is unavailable. The S3 integration test
            uses a plain GenericContainer on the SeaweedFS image instead.
        -->

        <!--
            Spring Security testing utilities. Provides the jwt() post-processor
            used by MockMvc tests to attach a synthetic JWT to a request
            so the SecurityContext is populated without a live Keycloak.
        -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
            Spring Cloud Stream test binder. Replaces the kafka binder with
            an in-memory TestChannelBinder so tests can verify "X was
            published to topic Y" without spinning up a real Kafka container.
            Imported via TestChannelBinderConfiguration in the test classes.
        -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-stream-test-binder</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Plugin versions and base config come from oriah-api-parent's pluginManagement. -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
