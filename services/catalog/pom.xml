<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.oriah</groupId>
        <artifactId>services</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>catalog</artifactId>
    <packaging>jar</packaging>

    <name>catalog</name>
    <description>Oriah catalog microservice — products, variants, collections.</description>

    <dependencies>
        <!-- Web -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!--
            Cross-cutting observability: tracing + metrics + JSON logs.
            See shared/oriah-observability-starter.
        -->
        <dependency>
            <groupId>com.oriah</groupId>
            <artifactId>oriah-observability-starter</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!--
            Shared JPA base: AuditableEntity (@MappedSuperclass with
            audit columns + @SoftDelete) + KeycloakAuditorAware.
            Activated by config/JpaConfig. Only entity-bearing
            services declare this; non-JPA services (configserver,
            eurekaserver, gatewayserver, shipping, checkout) do not,
            keeping their classpaths free of spring-data-*.
        -->
        <dependency>
            <groupId>com.oriah</groupId>
            <artifactId>oriah-jpa-base</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Persistence -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- API docs -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        </dependency>

        <!--
            Spring Cloud Config Client. Catalog pulls service-specific config
            (springdoc paths, logging levels, future settings) from the Config
            Server at startup. See the spring.config.import line in
            application.yaml — the 'optional:' prefix means catalog still boots
            when the Config Server is unreachable (tests, offline dev).
        -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-config</artifactId>
        </dependency>

        <!--
            Spring Cloud Eureka Client. Auto-registers catalog with the Eureka
            server on startup using spring.application.name (= "catalog") so
            other services (gateway, future inventory) can look it up by name
            instead of host:port. Disabled in tests via @TestPropertySource so
            tests don't depend on Eureka being up.
        -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-netflix-eureka-client</artifactId>
        </dependency>

        <!--
            OpenFeign: declarative HTTP client. Catalog uses an @FeignClient
            interface to call the inventory service via Eureka lookup
            (@FeignClient(name = "inventory")). The Feign auto-config wires
            in Spring Cloud LoadBalancer behind the scenes so we get
            client-side load balancing across however many inventory
            instances are registered.
        -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-openfeign</artifactId>
        </dependency>

        <!--
            Resilience4j circuit breaker. Wraps every Feign call: if
            inventory is unreachable or slow, the circuit opens and
            subsequent calls short-circuit to the fallback returning
            "availability unknown" — catalog stays up even when inventory
            is down. Enabled via feign.circuitbreaker.enabled: true in
            application.yaml.
        -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-circuitbreaker-resilience4j</artifactId>
        </dependency>

        <!--
            Spring Security + OAuth2 Resource Server.
            Catalog validates incoming JWTs against Keycloak's JWKS
            endpoint (configured via spring.security.oauth2.resourceserver.
            jwt.issuer-uri). Admin endpoints require the CATALOG_ADMIN
            role; public reads stay permitAll.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>

        <!--
            Spring Cloud Stream + Kafka binder. Catalog publishes
            product.created / product.updated / product.deleted domain
            events on a single 'catalog.product' topic via StreamBridge.
            Spring Cloud Stream's functional model means we just declare
            a destination in YAML and call StreamBridge.send — no
            @StreamListener boilerplate.
        -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-stream-kafka</artifactId>
        </dependency>

        <!-- Boilerplate reduction -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Dev convenience: hot reload during development. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>

        <!--
            Test classpath: Spring Boot 4 splits the old spring-boot-starter-test
            into per-feature test starters so the test classpath only has what
            the slice under test needs.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
            Spring Security testing utilities. Provides the jwt() post-processor
            used by MockMvc tests to attach a synthetic JWT to a request
            so the SecurityContext is populated without a live Keycloak.
        -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
            Spring Cloud Stream test binder. Replaces the kafka binder with
            an in-memory TestChannelBinder so tests can verify "X was
            published to topic Y" without spinning up a real Kafka container.
            Imported via TestChannelBinderConfiguration in the test classes.
        -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-stream-test-binder</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Plugin versions and base config come from oriah-api-parent's pluginManagement. -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
